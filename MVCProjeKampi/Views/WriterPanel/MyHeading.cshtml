@using EntityLayer.Concrete
@model List<Heading>
@{
    ViewBag.Title = "Başlıklarım";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}
@functions {
    public static string KategoriBorderRenk(int id)
    {
        string[] r = { "border-nude-green-border", "border-nude-orange-border", "border-nude-yellow-border", "border-nude-blue-border", "border-nude-pink-border", "border-nude-lila-border" };
        return r[id % r.Length];
    }
    public static string NudeChip(int id)
    {
        string[] r = { "bg-nude-green-bg text-nude-green-text", "bg-nude-orange-bg text-nude-orange-text", "bg-nude-yellow-bg text-nude-yellow-text", "bg-nude-blue-bg text-nude-blue-text", "bg-nude-pink-bg text-nude-pink-text", "bg-nude-lila-bg text-nude-lila-text" };
        return r[id % r.Length];
    }
}

<div class="max-w-4xl mx-auto flex flex-col gap-lg">
    <div class="flex items-center justify-between">
        <h1 class="font-headline-md text-headline-md text-primary">Başlıklarım</h1>
        <a href="/WriterPanel/NewHeading" class="flex items-center gap-xs px-lg py-2 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">
            <span class="material-symbols-outlined text-[18px]">add</span> Yeni Başlık
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-surface-container-lowest rounded-xl p-lg text-center text-on-surface-variant">Henüz başlık oluşturmadın.</div>
    }

    @foreach (var item in Model)
    {
        <article class="bg-surface-container-lowest rounded-xl p-lg border-4 @KategoriBorderRenk(item.CategoryID) shadow-[0_4px_16px_rgba(75,64,56,0.06)]">
            <div class="flex items-start justify-between gap-md flex-wrap">
                <div class="min-w-0">
                    <a href="/Default/Baslik/@item.HeadingID" class="font-headline-sm text-headline-sm text-on-surface hover:text-primary transition-colors break-words">@item.HeadingName</a>
                    <div class="flex items-center gap-sm mt-xs">
                        @if (item.Category != null)
                        {
                            <span class="px-3 py-1 @NudeChip(item.CategoryID) font-label-md rounded-full text-label-sm">@item.Category.CategoryName</span>
                        }
                        <span class="text-label-sm text-outline">@(Convert.ToDateTime(item.HeadingDate).ToString("dd-MM-yyyy"))</span>
                    </div>
                </div>
                <div class="flex items-center gap-sm">
                    <a href="/Default/Baslik/@item.HeadingID" class="group flex items-center gap-xs px-md py-2 border border-nude-blue-border text-nude-blue-text font-label-md rounded-full hover:bg-nude-blue-bg transition-all">
                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                        <span class="hidden group-hover:inline">Gör</span>
                    </a>
                    <a href="/WriterPanel/EditHeading/@item.HeadingID" class="group flex items-center gap-xs px-md py-2 border border-nude-orange-border text-nude-orange-text font-label-md rounded-full hover:bg-nude-orange-bg transition-all">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                        <span class="hidden group-hover:inline">Düzenle</span>
                    </a>
                    <a href="/WriterPanel/DeleteHeading/@item.HeadingID" onclick="return confirm('Bu başlığı silmek istediğinize emin misiniz?');" class="group flex items-center gap-xs px-md py-2 border border-nude-pink-border text-nude-pink-text font-label-md rounded-full hover:bg-nude-pink-bg transition-all">
                        <span class="material-symbols-outlined text-[18px]">delete</span>
                        <span class="hidden group-hover:inline">Sil</span>
                    </a>
                </div>
            </div>
        </article>
    }
</div>