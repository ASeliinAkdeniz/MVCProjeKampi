@model EntityLayer.Concrete.Heading
@{
    ViewBag.Title = "Yeni Başlık";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-surface-container-lowest rounded-xl p-lg border-4 border-nude-lila-border shadow-[0_4px_16px_rgba(75,64,56,0.06)]">
        <h1 class="font-headline-md text-headline-md text-primary mb-lg">Yeni Başlık Oluştur</h1>

        @using (Html.BeginForm("NewHeading", "WriterPanel", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="flex flex-col gap-md">
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Başlık Adı</label>
                    @Html.TextBoxFor(x => x.HeadingName, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all", placeholder = "Başlık adını yaz..." })
                    @Html.ValidationMessageFor(x => x.HeadingName, "", new { @class = "text-nude-pink-text text-label-sm" })
                </div>
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Kategori</label>
                    @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.vlc, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                </div>
                <div class="flex justify-end mt-sm">
                    <button type="submit" class="px-lg py-2.5 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">Başlığı Oluştur</button>
                </div>
            </div>
        }
    </div>
</div>