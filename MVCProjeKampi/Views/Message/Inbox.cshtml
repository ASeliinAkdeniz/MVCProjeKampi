@using EntityLayer.Concrete
@model List<Message>
@{
    ViewBag.Title = "Gelen Kutusu";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="flex flex-col gap-lg">
    <div class="flex items-center justify-between">
        <h2 class="font-headline-md text-headline-md text-primary">Gelen Kutusu</h2>
        <div class="flex items-center gap-sm">
            <a href="/Message/Sendbox" class="flex items-center gap-xs px-lg py-2 border border-primary text-primary font-label-md rounded-full hover:bg-primary/10 transition-all">
                <span class="material-symbols-outlined text-[18px]">send</span> Gönderilenler
            </a>
            <a href="/Message/NewMessage" class="flex items-center gap-xs px-lg py-2 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">
                <span class="material-symbols-outlined text-[18px]">edit</span> Yeni Mesaj
            </a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="bg-surface-container-lowest rounded-xl p-lg text-center text-on-surface-variant">Gelen mesajın yok.</div>
    }

    <div class="flex flex-col gap-sm">
        @foreach (var item in Model)
        {
            <div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0_4px_16px_rgba(75,64,56,0.06)]">
                <div class="flex items-center gap-md">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center bg-nude-blue-bg text-nude-blue-text font-label-md shrink-0">
                        @(!string.IsNullOrEmpty(item.SenderMail) ? item.SenderMail.Substring(0,1).ToUpper() : "?")
                    </div>
                    <a href="/Message/GetInboxMessageDetails/@item.MessageID" class="block" style="flex:1 1 auto; overflow:hidden;">
                        <div class="font-label-md text-on-surface" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.SenderMail</div>
                        <div class="text-on-surface-variant text-label-sm" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Subject</div>
                    </a>
                    <span class="text-label-sm text-outline shrink-0 hidden md:block">@(((DateTime)item.MessageDate).ToString("dd-MM-yyyy"))</span>
                </div>
            </div>
        }
    </div>
</div>