@model EntityLayer.Concrete.Message
@{
    ViewBag.Title = "Gönderilen Mesaj";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="max-w-3xl mx-auto flex flex-col gap-lg">
    <div class="flex items-center justify-between">
        <h2 class="font-headline-md text-headline-md text-primary">Gönderilen Mesaj</h2>
        <a href="/Message/Sendbox" class="flex items-center gap-xs px-lg py-2 border border-[#EFE6DD] text-on-surface-variant font-label-md rounded-full hover:bg-surface-container transition-all">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Geri
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border-4 border-nude-green-border shadow-[0_4px_16px_rgba(75,64,56,0.06)] overflow-hidden">
        <div class="p-lg border-b border-[#EFE6DD]">
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-md break-words">@Model.Subject</h3>
            <div class="flex items-center gap-md">
                <div class="w-11 h-11 rounded-full flex items-center justify-center bg-nude-green-bg text-nude-green-text font-label-md shrink-0">
                    @(!string.IsNullOrEmpty(Model.ReceiverMail) ? Model.ReceiverMail.Substring(0,1).ToUpper() : "?")
                </div>
                <div class="min-w-0" style="flex:1 1 auto;">
                    <div class="text-label-sm text-outline">Kime:</div>
                    <div class="font-label-md text-on-surface break-words">@Model.ReceiverMail</div>
                    <div class="text-label-sm text-outline">@(((DateTime)Model.MessageDate).ToString("dd MMMM yyyy"))</div>
                </div>
            </div>
        </div>
        <div class="p-lg">
            <p class="font-body-lg text-on-surface leading-relaxed break-words" style="white-space:pre-wrap;">@Model.MessageContent</p>
        </div>
    </div>
</div>