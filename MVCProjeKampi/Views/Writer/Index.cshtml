@using EntityLayer.Concrete
@model List<Writer>
@{
    ViewBag.Title = "Yazarlar";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}
@functions {
    public static string YazarAvatarRenk(int id)
    {
        string[] r = { "bg-nude-green-bg text-nude-green-text", "bg-nude-orange-bg text-nude-orange-text", "bg-nude-yellow-bg text-nude-yellow-text", "bg-nude-blue-bg text-nude-blue-text", "bg-nude-pink-bg text-nude-pink-text", "bg-nude-lila-bg text-nude-lila-text" };
        return r[id % r.Length];
    }
}

<div class="flex flex-col gap-lg">
    <div class="flex items-center justify-between">
        <h2 class="font-headline-md text-headline-md text-primary">Yazarlar</h2>
        <a href="/Writer/AddWriter" class="flex items-center gap-xs px-lg py-2 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">
            <span class="material-symbols-outlined text-[18px]">person_add</span> Yeni Yazar
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md">
        @foreach (var item in Model)
        {
            <div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0_4px_16px_rgba(75,64,56,0.06)] flex flex-col items-center text-center">
                @if (!string.IsNullOrEmpty(item.WriterImage))
                {
                    <img src="@item.WriterImage" alt="@item.WriterName" class="w-20 h-20 rounded-full object-cover border-4 border-nude-lila-border" />
                }
                else
                {
                    <div class="w-20 h-20 rounded-full flex items-center justify-center border-4 border-nude-lila-border font-headline-md @YazarAvatarRenk(item.WriterID)">
                        @(!string.IsNullOrEmpty(item.WriterName) ? item.WriterName.Substring(0,1).ToUpper() : "?")
                    </div>
                }
                <h3 class="font-headline-sm text-headline-sm text-on-surface mt-md break-words">@item.WriterName @item.WriterSurname</h3>
                <p class="text-on-surface-variant font-label-md">@item.WriterTitle</p>
                <p class="text-label-sm text-outline mt-xs break-words">@item.WriterMail</p>

                <div class="flex items-center gap-sm mt-md">
                    <a href="/Writer/EditWriter/@item.WriterID" class="flex items-center gap-xs px-md py-1.5 border border-nude-orange-border text-nude-orange-text rounded-full hover:bg-nude-orange-bg transition-all text-label-sm">
                        <span class="material-symbols-outlined text-[16px]">edit</span> Düzenle
                    </a>
                </div>
            </div>
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="bg-surface-container-lowest rounded-xl p-lg text-center text-on-surface-variant">Henüz yazar yok.</div>
    }
</div>