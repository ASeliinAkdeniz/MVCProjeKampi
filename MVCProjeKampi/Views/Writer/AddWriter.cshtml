@model EntityLayer.Concrete.Writer
@{
    ViewBag.Title = "Yeni Yazar";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-surface-container-lowest rounded-xl p-lg border-4 border-nude-green-border shadow-[0_4px_16px_rgba(75,64,56,0.06)]">
        <div class="flex items-center gap-sm mb-lg">
            <span class="material-symbols-outlined text-nude-green-text">person_add</span>
            <h2 class="font-headline-md text-headline-md text-nude-green-text">Yeni Yazar Ekle</h2>
        </div>

        @using (Html.BeginForm("AddWriter", "Writer", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="flex flex-col gap-md">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                    <div>
                        <label class="block font-label-md text-on-surface-variant mb-xs">Ad</label>
                        @Html.TextBoxFor(x => x.WriterName, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                        @Html.ValidationMessageFor(x => x.WriterName, "", new { @class = "text-nude-pink-text text-label-sm" })
                    </div>
                    <div>
                        <label class="block font-label-md text-on-surface-variant mb-xs">Soyad</label>
                        @Html.TextBoxFor(x => x.WriterSurname, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                    </div>
                </div>
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Mail</label>
                    @Html.TextBoxFor(x => x.WriterMail, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                    @Html.ValidationMessageFor(x => x.WriterMail, "", new { @class = "text-nude-pink-text text-label-sm" })
                </div>
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Şifre</label>
                    @Html.PasswordFor(x => x.WriterPassword, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                    @Html.ValidationMessageFor(x => x.WriterPassword, "", new { @class = "text-nude-pink-text text-label-sm" })
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                    <div>
                        <label class="block font-label-md text-on-surface-variant mb-xs">Ünvan</label>
                        @Html.TextBoxFor(x => x.WriterTitle, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                    </div>
                    <div>
                        <label class="block font-label-md text-on-surface-variant mb-xs">Görsel Linki</label>
                        @Html.TextBoxFor(x => x.WriterImage, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                    </div>
                </div>
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Hakkında</label>
                    @Html.TextAreaFor(x => x.WriterAbout, new { rows = 3, @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                </div>
                <div class="flex justify-end gap-sm mt-sm">
                    <a href="/Writer/Index" class="px-lg py-2.5 border border-[#EFE6DD] text-on-surface-variant font-label-md rounded-full hover:bg-surface-container transition-all">Vazgeç</a>
                    <button type="submit" class="px-lg py-2.5 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">Kaydet</button>
                </div>
            </div>
        }
    </div>
</div>