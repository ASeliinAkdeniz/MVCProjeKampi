@model EntityLayer.Concrete.Admin
@{
    ViewBag.Title = "Yetki Değiştir";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="max-w-xl mx-auto">
    <div class="bg-surface-container-lowest rounded-xl p-lg border-4 border-nude-orange-border shadow-[0_4px_16px_rgba(75,64,56,0.06)]">
        <div class="flex items-center gap-sm mb-lg">
            <span class="material-symbols-outlined text-nude-orange-text">admin_panel_settings</span>
            <h2 class="font-headline-md text-headline-md text-nude-orange-text">Yetkiyi Değiştir</h2>
        </div>

        @using (Html.BeginForm("EditAdmin", "Authorization", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.AdminId)
            <div class="flex flex-col gap-md">
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Kullanıcı Adı</label>
                    @Html.TextBoxFor(x => x.AdminUserName, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                </div>
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Yetki</label>
                    @Html.DropDownListFor(x => x.AdminRole, (List<SelectListItem>)ViewBag.roller, new { @class = "w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" })
                </div>
                <div>
                    <label class="block font-label-md text-on-surface-variant mb-xs">Yeni Şifre <span class="text-outline">(değiştirmek istemiyorsan boş bırak)</span></label>
                    <input type="password" name="yeniSifre" placeholder="••••••••"
                           class="w-full px-4 py-2.5 bg-surface-container-lowest border border-[#EFE6DD] rounded-xl font-body-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                </div>
                <div class="flex justify-end gap-sm mt-sm">
                    <a href="/Authorization/Index" class="px-lg py-2.5 border border-[#EFE6DD] text-on-surface-variant font-label-md rounded-full hover:bg-surface-container transition-all">Vazgeç</a>
                    <button type="submit" class="px-lg py-2.5 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">Güncelle</button>
                </div>
            </div>
        }
    </div>
</div>