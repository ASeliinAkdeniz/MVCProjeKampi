@model EntityLayer.Concrete.Admin
@{
    ViewBag.Title = "Şifre Değiştir";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}
<br />
<h2>Şifremi Değiştir</h2>

@if (ViewBag.Mesaj != null)
{
    <div class="alert alert-info">@ViewBag.Mesaj</div>
}

@using (Html.BeginForm("ChangePassword", "AdminProfile", FormMethod.Post))
{
    <div class="form-group">
        @Html.Label("Kullanıcı Adı")
        <input type="text" class="form-control" value="@Model.AdminUserName" readonly />
        <br />
        @Html.Label("Yeni Şifre")
        <input type="password" name="yeniSifre" class="form-control" />
        <br />
        @Html.Label("Yeni Şifre (Tekrar)")
        <input type="password" name="yeniSifreTekrar" class="form-control" />
        <br />
        <button class="btn btn-success">Şifreyi Güncelle</button>
    </div>
}