@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sayfa Bulunamadı - Tatlı Sözlük</title>
    <link href="~/Content/tailwind.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
</head>
<body class="font-body-md text-on-surface antialiased" style="min-height:100vh; margin:0; display:flex; flex-direction:column; background-color:#FBF7F3;">

    <header style="padding:32px 40px; text-align:center;">
        <a href="/Default/HomePage" style="display:inline-flex; align-items:center; gap:10px; text-decoration:none;">
            <span class="material-symbols-outlined text-primary" style="font-size:44px;">menu_book</span>
            <span class="font-headline-md font-bold text-primary" style="font-size:34px;">Tatlı Sözlük</span>
        </a>
    </header>

    <main style="flex:1; display:flex; align-items:center; justify-content:center; padding:24px;">
        <div class="bg-surface-container-lowest border-4 border-nude-lila-border shadow-[0_4px_16px_rgba(75,64,56,0.06)]"
             style="width:100%; max-width:560px; border-radius:20px; padding:48px; text-align:center;">

            <div class="font-headline-md text-primary" style="font-size:96px; line-height:1; font-weight:700;">404</div>

            <h1 class="font-headline-md" style="color:#8A6440; font-size:24px; margin:16px 0 8px 0;">Bu sayfa kayıplara karışmış</h1>

            <p class="text-on-surface-variant font-body-md" style="margin-bottom:32px;">
                Aradığın sayfa taşınmış, silinmiş ya da hiç var olmamış olabilir.
                Merak etme, sözlükte gezilecek çok yer var.
            </p>

            <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
                <a href="/Default/HomePage" class="bg-primary text-on-primary font-label-md hover:brightness-110 transition-all"
                   style="display:inline-flex; align-items:center; gap:6px; padding:12px 24px; border-radius:9999px; text-decoration:none;">
                    <span class="material-symbols-outlined text-[18px]">home</span> Ana Sayfa
                </a>
                <a href="/Default/Hakkimizda" class="border border-primary text-primary font-label-md hover:bg-primary/10 transition-all"
                   style="display:inline-flex; align-items:center; gap:6px; padding:12px 24px; border-radius:9999px; text-decoration:none;">
                    <span class="material-symbols-outlined text-[18px]">info</span> Hakkımızda
                </a>
            </div>
        </div>
    </main>
</body>
</html>