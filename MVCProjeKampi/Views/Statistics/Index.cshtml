
@{
    Layout = null;
    var enAktif = ViewBag.EnAktifYazarlar as List<KeyValuePair<string, int>>;
    int enYuksek = (enAktif != null && enAktif.Count > 0) ? enAktif.Max(x => x.Value) : 1;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sözlük İstatistikleri</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #0f172a;
            color: #e2e8f0;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .kap {
            max-width: 900px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            font-size: 30px;
            margin-bottom: 6px;
        }

        .altbaslik {
            text-align: center;
            color: #94a3b8;
            margin-bottom: 36px;
        }

        .kartlar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 18px;
            margin-bottom: 44px;
        }

        .kart {
            background: linear-gradient(135deg, #1e293b, #334155);
            border-radius: 16px;
            padding: 26px 20px;
            text-align: center;
            border: 1px solid #334155;
        }

        .sayi {
            font-size: 40px;
            font-weight: 800;
            color: #38bdf8;
        }

        .etiket {
            color: #cbd5e1;
            margin-top: 6px;
            font-size: 15px;
        }

        .bolum-baslik {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .yazar-satir {
            margin-bottom: 14px;
        }

        .yazar-ust {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 15px;
        }

        .yazar-adet {
            color: #38bdf8;
            font-weight: 700;
        }

        .cubuk-arka {
            background: #1e293b;
            border-radius: 8px;
            height: 12px;
            overflow: hidden;
        }

        .cubuk-dolu {
            background: linear-gradient(90deg, #38bdf8, #818cf8);
            height: 100%;
            border-radius: 8px;
        }

        .bos {
            color: #94a3b8;
        }
    </style>
</head>
<body>
    <div class="kap">
        <h1>Sözlük İstatistikleri</h1>
        <p class="altbaslik">Sözlüğümüzün güncel künyesi ve en aktif yazarları</p>

        <div class="kartlar">
            <div class="kart">
                <div class="sayi">@ViewBag.BaslikSayisi</div>
                <div class="etiket">Başlık</div>
            </div>
            <div class="kart">
                <div class="sayi">@ViewBag.EntrySayisi</div>
                <div class="etiket">Entry</div>
            </div>
            <div class="kart">
                <div class="sayi">@ViewBag.YazarSayisi</div>
                <div class="etiket">Yazar</div>
            </div>
            <div class="kart">
                <div class="sayi">@ViewBag.KategoriSayisi</div>
                <div class="etiket">Kategori</div>
            </div>
        </div>

        <div class="bolum-baslik">En Aktif Yazarlar</div>
        @if (enAktif == null || enAktif.Count == 0)
        {
            <p class="bos">Henüz yeterli veri yok.</p>
        }
        else
        {
            foreach (var item in enAktif)
            {
                var yuzde = (int)((double)item.Value / enYuksek * 100);
                <div class="yazar-satir">
                    <div class="yazar-ust">
                        <span>@item.Key</span>
                        <span class="yazar-adet">@item.Value entry</span>
                    </div>
                    <div class="cubuk-arka">
                        <div class="cubuk-dolu" style="width:@yuzde%"></div>
                    </div>
                </div>
            }
        }
    </div>
</body>
</html>