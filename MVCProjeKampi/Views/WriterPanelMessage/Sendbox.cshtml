@using EntityLayer.Concrete
@model List<Message>
@{
    ViewBag.Title = "Gönderilenler";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
    var writerImages = ViewBag.WriterImages as Dictionary<string, string>;
}

<div class="grid grid-cols-1 md:grid-cols-12 gap-lg">
    @Html.Action("MessageListMenu", "WriterPanelMessage")

    <div class="md:col-span-9">
        <h1 class="font-headline-md text-headline-md text-primary mb-lg">Gönderilen Mesajlar</h1>

        @if (Model == null || Model.Count == 0)
        {
            <div class="bg-surface-container-lowest rounded-xl p-lg text-center text-on-surface-variant">Gönderdiğin mesaj yok.</div>
        }
        <div class="flex flex-col gap-sm">
            @foreach (var item in Model)
            {
                <div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0_4px_16px_rgba(75,64,56,0.06)]">
                    <div class="flex items-center gap-md">
                        @{
                            string foto = (writerImages != null && item.ReceiverMail != null && writerImages.ContainsKey(item.ReceiverMail)) ? writerImages[item.ReceiverMail] : null;
                        }
                        @if (!string.IsNullOrEmpty(foto))
                        {
                            <img src="@foto" alt="@item.ReceiverMail" class="w-10 h-10 rounded-full object-cover border-2 border-nude-green-border shrink-0" />
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-full flex items-center justify-center bg-nude-green-bg text-nude-green-text font-label-md shrink-0">
                                @(!string.IsNullOrEmpty(item.ReceiverMail) ? item.ReceiverMail.Substring(0,1).ToUpper() : "?")
                            </div>
                        }

                        <!-- Alıcı + konu -->
                        <a href="/WriterPanelMessage/GetSendboxMessageDetails/@item.MessageID" class="block" style="flex:1 1 auto; overflow:hidden;">
                            <div class="font-label-md text-on-surface" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                <span class="text-outline text-label-sm">Kime: </span>@item.ReceiverMail
                            </div>
                            <div class="text-on-surface-variant text-label-sm" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Subject</div>
                        </a>

                        <!-- Tarih -->
                        <span class="text-label-sm text-outline shrink-0 hidden md:block">@(((DateTime)item.MessageDate).ToString("dd-MM-yyyy"))</span>

                        <!-- Çöpe at -->
                        <a href="/WriterPanelMessage/MoveToTrash/@item.MessageID?from=Sendbox"
                           onclick="return confirm('Bu mesajı çöp kutusuna taşımak istediğinize emin misiniz?');"
                           class="flex items-center px-md py-2 border border-nude-pink-border text-nude-pink-text rounded-full hover:bg-nude-pink-bg transition-all shrink-0">
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>