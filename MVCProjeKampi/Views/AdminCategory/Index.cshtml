@using EntityLayer.Concrete
@model List<Category>
@{
    ViewBag.Title = "Kategoriler";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="flex flex-col gap-lg">
    <div class="flex items-center justify-between">
        <h2 class="font-headline-md text-headline-md text-primary">Kategoriler</h2>
        <a href="/AdminCategory/AddCategory" class="flex items-center gap-xs px-lg py-2 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">
            <span class="material-symbols-outlined text-[18px]">add</span> Yeni Kategori
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl shadow-[0_4px_16px_rgba(75,64,56,0.06)] overflow-hidden">
        <table class="w-full">
            <thead>
                <tr class="bg-nude-lila-bg text-nude-lila-text">
                    <th class="text-left px-lg py-3 font-label-md">#</th>
                    <th class="text-left px-lg py-3 font-label-md">Kategori Adı</th>
                    <th class="text-right px-lg py-3 font-label-md">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-t border-[#EFE6DD] hover:bg-primary/5 transition-colors">
                        <td class="px-lg py-3 text-outline">@item.CategoryID</td>
                        <td class="px-lg py-3 text-on-surface font-label-md">@item.CategoryName</td>
                        <td class="px-lg py-3">
                            <div class="flex items-center justify-end gap-sm">
                                <a href="/AdminCategory/EditCategory/@item.CategoryID" class="flex items-center gap-xs px-md py-1.5 border border-nude-orange-border text-nude-orange-text rounded-full hover:bg-nude-orange-bg transition-all text-label-sm">
                                    <span class="material-symbols-outlined text-[16px]">edit</span> Düzenle
                                </a>
                                <a href="/AdminCategory/DeleteCategory/@item.CategoryID" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');" class="flex items-center gap-xs px-md py-1.5 border border-nude-pink-border text-nude-pink-text rounded-full hover:bg-nude-pink-bg transition-all text-label-sm">
                                    <span class="material-symbols-outlined text-[16px]">delete</span> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0)
        {
            <div class="px-lg py-lg text-center text-on-surface-variant">Henüz kategori yok.</div>
        }
    </div>
</div>