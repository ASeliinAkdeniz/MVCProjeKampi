
@using EntityLayer.Concrete
@model List<Heading>
@{
    ViewBag.Title = "Kategori";
    Layout = Session["WriterMail"] != null
    ? "~/Views/Shared/_WriterLayout.cshtml"
    : "~/Views/Shared/_vitrinLayout.cshtml";
    var trending = ViewBag.Trending as List<Heading>;
    var tcounts = ViewBag.TrendingCounts as Dictionary<int, int>;
    var categories = ViewBag.Categories as List<Category>;
    var entryCounts = ViewBag.EntryCounts as Dictionary<int, int>;
    var latestEntry = ViewBag.LatestEntry as Dictionary<int, string>;
    var categoryNames = ViewBag.CategoryNames as Dictionary<int, string>;
}
@functions {
    public static string NudeChip(int id)
    {
        string[] r = { "bg-nude-green-bg text-nude-green-text", "bg-nude-orange-bg text-nude-orange-text", "bg-nude-yellow-bg text-nude-yellow-text", "bg-nude-blue-bg text-nude-blue-text", "bg-nude-pink-bg text-nude-pink-text", "bg-nude-lila-bg text-nude-lila-text" };
        return r[id % r.Length];
    }
    public static string KategoriBorderRenk(int id)
    {
        string[] r = { "border-nude-green-border", "border-nude-orange-border", "border-nude-yellow-border", "border-nude-blue-border", "border-nude-pink-border", "border-nude-lila-border" };
        return r[id % r.Length];
    }
    public static string KategoriBgRenk(int id)
    {
        string[] r = { "bg-nude-green", "bg-nude-orange", "bg-nude-yellow", "bg-nude-blue", "bg-nude-pink", "bg-nude-lila" };
        return r[id % r.Length];
    }
}

<div class="grid grid-cols-1 md:grid-cols-12 gap-lg">

    <!-- SOL: Gündem -->
    <aside class="md:col-span-3 hidden md:flex flex-col gap-lg h-fit sticky top-24 min-w-0">
        <div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0_4px_16px_rgba(75,64,56,0.06)] min-w-0">
            <div class="flex items-center gap-sm mb-lg">
                <span class="material-symbols-outlined text-primary">trending_up</span>
                <h2 class="font-headline-sm text-headline-sm text-on-surface">Gündem</h2>
            </div>
            <ul class="space-y-md">
                @foreach (var t in trending)
                {
                    var tc = (tcounts != null && tcounts.ContainsKey(t.HeadingID)) ? tcounts[t.HeadingID] : 0;
                    <li class="min-w-0">
                        <a class="flex items-stretch gap-sm group" href="/Default/Baslik/@t.HeadingID">
                            <span class="w-1 rounded-full shrink-0 @KategoriBgRenk(t.CategoryID)"></span>
                            <span class="min-w-0">
                                <span class="block font-body-md text-on-surface hover:text-primary transition-colors break-words">@t.HeadingName</span>
                                <span class="block text-label-sm text-outline">@tc entry</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </aside>

    <!-- ORTA: Arama sonuçları -->
    <section class="md:col-span-6 flex flex-col gap-lg min-w-0">
        <div class="bg-surface-container-lowest rounded-xl p-lg border-4 border-nude-lila-border">
            <h1 class="font-headline-sm text-headline-sm text-on-surface">
                <span class="text-primary">@ViewBag.CategoryName</span> kategorisi — @Model.Count başlık
            </h1>
        </div>

        @if (Model.Count == 0)
        {
            <div class="bg-surface-container-lowest rounded-xl p-lg text-center text-on-surface-variant">
                Eşleşen başlık veya entry bulunamadı.
            </div>
        }
        @foreach (var item in Model)
        {
            var entryCount = (entryCounts != null && entryCounts.ContainsKey(item.HeadingID)) ? entryCounts[item.HeadingID] : 0;
            var preview = (latestEntry != null && latestEntry.ContainsKey(item.HeadingID)) ? latestEntry[item.HeadingID] : "";
            var catName = (categoryNames != null && categoryNames.ContainsKey(item.CategoryID)) ? categoryNames[item.CategoryID] : "";
            <article class="bg-surface-container-lowest rounded-xl p-lg border-4 @KategoriBorderRenk(item.CategoryID) shadow-[0_4px_16px_rgba(75,64,56,0.06)] hover:shadow-md transition-shadow group">
                <a href="/Default/Baslik/@item.HeadingID" class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">@item.HeadingName</a>
                @if (!string.IsNullOrEmpty(preview))
                {
                    <p class="font-body-md text-on-surface-variant leading-relaxed line-clamp-3 mt-md">@preview</p>
                }
                <div class="flex items-center justify-between border-t border-[#EFE6DD] pt-md mt-md">
                    <div class="flex items-center gap-sm">
                        <span class="material-symbols-outlined text-outline text-[20px]">forum</span>
                        <span class="font-label-md text-on-surface-variant">@entryCount entry</span>
                    </div>
                    @if (!string.IsNullOrEmpty(catName))
                    {
                        <span class="px-4 py-1.5 @NudeChip(item.CategoryID) font-label-md rounded-full">@catName</span>
                    }
                </div>
            </article>
        }
    </section>

    <!-- SAĞ: Kategoriler + İstatistikler -->
    <aside class="md:col-span-3 hidden md:flex flex-col gap-lg h-fit sticky top-24 min-w-0">
        <div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0_4px_16px_rgba(75,64,56,0.06)] min-w-0">
            <h2 class="font-headline-sm text-headline-sm text-on-surface mb-lg">Kategoriler</h2>
            <div class="flex flex-wrap gap-sm">
                @foreach (var cat in categories)
                {
                    <a href="/Default/Kategori/@cat.CategoryID" class="px-4 py-1.5 @NudeChip(cat.CategoryID) font-label-md rounded-full whitespace-nowrap max-w-full truncate">@cat.CategoryName</a>
                }
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-lg border border-primary/10 min-w-0">
            <h2 class="font-headline-sm text-headline-sm text-on-surface mb-lg">İstatistikler</h2>
            <div class="grid grid-cols-1 gap-sm">
                <div class="bg-nude-green-bg rounded-xl p-md flex items-center justify-between">
                    <span class="font-label-md text-nude-green-text">Başlık</span>
                    <span class="font-headline-sm text-nude-green-text">@ViewBag.TotalHeadings</span>
                </div>
                <div class="bg-nude-orange-bg rounded-xl p-md flex items-center justify-between">
                    <span class="font-label-md text-nude-orange-text">Entry</span>
                    <span class="font-headline-sm text-nude-orange-text">@ViewBag.TotalEntries</span>
                </div>
                <div class="bg-nude-blue-bg rounded-xl p-md flex items-center justify-between">
                    <span class="font-label-md text-nude-blue-text">Yazar</span>
                    <span class="font-headline-sm text-nude-blue-text">@ViewBag.TotalWriters</span>
                </div>
            </div>
        </div>
    </aside>
</div>

