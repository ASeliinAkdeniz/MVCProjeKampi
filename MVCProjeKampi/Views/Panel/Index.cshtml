@using EntityLayer.Concrete
@{
    ViewBag.Title = "Panel";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
    var sonBasliklar = ViewBag.SonBasliklar as List<Heading>;
}

<div class="flex flex-col gap-lg">

    <!-- Hoş geldin -->
    <div class="bg-surface-container-lowest rounded-xl p-lg border-4 border-nude-lila-border">
        <h2 class="font-headline-md text-headline-md text-primary">Hoş geldin, @User.Identity.Name 👋</h2>
        <p class="text-on-surface-variant mt-xs">Tatlı Sözlük yönetim paneli. Aşağıdan sitenin genel durumunu görebilirsin.</p>
    </div>

    <!-- İstatistik kartları -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-md">
        <div class="bg-nude-green-bg rounded-xl p-lg flex items-center gap-md">
            <div class="w-12 h-12 rounded-full bg-nude-green flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-nude-green-text">article</span></div>
            <div><div class="font-display-lg text-nude-green-text" style="font-size:28px;">@ViewBag.TotalHeadings</div><div class="font-label-md text-nude-green-text">Başlık</div></div>
        </div>
        <div class="bg-nude-orange-bg rounded-xl p-lg flex items-center gap-md">
            <div class="w-12 h-12 rounded-full bg-nude-orange flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-nude-orange-text">chat</span></div>
            <div><div class="font-display-lg text-nude-orange-text" style="font-size:28px;">@ViewBag.TotalEntries</div><div class="font-label-md text-nude-orange-text">Entry</div></div>
        </div>
        <div class="bg-nude-blue-bg rounded-xl p-lg flex items-center gap-md">
            <div class="w-12 h-12 rounded-full bg-nude-blue flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-nude-blue-text">group</span></div>
            <div><div class="font-display-lg text-nude-blue-text" style="font-size:28px;">@ViewBag.TotalWriters</div><div class="font-label-md text-nude-blue-text">Yazar</div></div>
        </div>
        <div class="bg-nude-pink-bg rounded-xl p-lg flex items-center gap-md">
            <div class="w-12 h-12 rounded-full bg-nude-pink flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-nude-pink-text">category</span></div>
            <div><div class="font-display-lg text-nude-pink-text" style="font-size:28px;">@ViewBag.TotalCategories</div><div class="font-label-md text-nude-pink-text">Kategori</div></div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
        <!-- Hızlı erişim -->
        <div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0_4px_16px_rgba(75,64,56,0.06)]">
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-md">Hızlı Erişim</h3>
            <div class="flex flex-col gap-sm">
                <a href="/AdminCategory/AddCategory" class="flex items-center gap-sm px-md py-2.5 rounded-xl bg-nude-green-bg text-nude-green-text hover:brightness-95 transition-all font-label-md"><span class="material-symbols-outlined text-[20px]">add</span> Yeni Kategori</a>
                <a href="/Writer/AddWriter" class="flex items-center gap-sm px-md py-2.5 rounded-xl bg-nude-blue-bg text-nude-blue-text hover:brightness-95 transition-all font-label-md"><span class="material-symbols-outlined text-[20px]">person_add</span> Yeni Yazar</a>
                <a href="/Contact/Index" class="flex items-center gap-sm px-md py-2.5 rounded-xl bg-nude-orange-bg text-nude-orange-text hover:brightness-95 transition-all font-label-md"><span class="material-symbols-outlined text-[20px]">mail</span> Mesajlar</a>
                <a href="/Chart/Index" class="flex items-center gap-sm px-md py-2.5 rounded-xl bg-nude-lila-bg text-nude-lila-text hover:brightness-95 transition-all font-label-md"><span class="material-symbols-outlined text-[20px]">bar_chart</span> Grafikler</a>
            </div>
        </div>

        <!-- Son eklenen başlıklar -->
        <div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0_4px_16px_rgba(75,64,56,0.06)] md:col-span-2">
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-md">Son Eklenen Başlıklar</h3>
            @if (sonBasliklar == null || sonBasliklar.Count == 0)
            {
                <p class="text-on-surface-variant">Henüz başlık yok.</p>
            }
            else
            {
        <div class="flex flex-col gap-sm">
            @foreach (var b in sonBasliklar)
            {
                <a href="/Heading/Index" class="flex items-center justify-between px-md py-2.5 rounded-xl hover:bg-primary/5 transition-colors border border-[#EFE6DD]">
                    <span class="text-on-surface break-words">@b.HeadingName</span>
                    <span class="material-symbols-outlined text-[18px] text-outline">chevron_right</span>
                </a>
            }
        </div>
            }
        </div>
    </div>
</div>