@using EntityLayer.Concrete
@using PagedList
@model IPagedList<Heading>
@{
    ViewBag.Title = "Başlıklar";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="flex flex-col gap-lg">
    <div class="flex items-center justify-between">
        <h2 class="font-headline-md text-headline-md text-primary">Başlıklar</h2>
        <a href="/Heading/AddHeading" class="flex items-center gap-xs px-lg py-2 bg-primary text-on-primary font-label-md rounded-full hover:brightness-110 transition-all">
            <span class="material-symbols-outlined text-[18px]">add</span> Yeni Başlık
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl shadow-[0_4px_16px_rgba(75,64,56,0.06)] overflow-hidden">
        <table class="w-full">
            <thead>
                <tr class="bg-nude-lila-bg text-nude-lila-text">
                    <th class="text-left px-lg py-3 font-label-md">#</th>
                    <th class="text-left px-lg py-3 font-label-md">Başlık Adı</th>
                    <th class="text-left px-lg py-3 font-label-md hidden md:table-cell">Kategori</th>
                    <th class="text-right px-lg py-3 font-label-md">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-t border-[#EFE6DD] hover:bg-primary/5 transition-colors">
                        <td class="px-lg py-3 text-outline">@item.HeadingID</td>
                        <td class="px-lg py-3 text-on-surface font-label-md break-words">@item.HeadingName</td>
                        <td class="px-lg py-3 text-on-surface-variant hidden md:table-cell">@(item.Category != null ? item.Category.CategoryName : "-")</td>
                        <td class="px-lg py-3">
                            <div class="flex items-center justify-end gap-sm">
                                <a href="/Heading/EditHeading/@item.HeadingID" class="flex items-center gap-xs px-md py-1.5 border border-nude-orange-border text-nude-orange-text rounded-full hover:bg-nude-orange-bg transition-all text-label-sm">
                                    <span class="material-symbols-outlined text-[16px]">edit</span> Düzenle
                                </a>
                                <a href="/Heading/DeleteHeading/@item.HeadingID" onclick="return confirm('Bu başlığı silmek istediğinize emin misiniz?');" class="flex items-center gap-xs px-md py-1.5 border border-nude-pink-border text-nude-pink-text rounded-full hover:bg-nude-pink-bg transition-all text-label-sm">
                                    <span class="material-symbols-outlined text-[16px]">delete</span> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="px-lg py-lg text-center text-on-surface-variant">Henüz başlık yok.</div>
        }
    </div>
    @if (Model.PageCount > 1)
    {
        <div class="flex items-center justify-center gap-sm mt-lg flex-wrap">
            @if (Model.HasPreviousPage)
            {
                <a href="@Url.Action("Index", new { page = Model.PageNumber - 1 })" class="px-3 py-2 rounded-full bg-surface-container-lowest border border-[#EFE6DD] text-on-surface hover:bg-primary/10 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
            }
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                if (i == Model.PageNumber)
                {
                    <span class="px-4 py-2 rounded-full bg-primary text-on-primary font-label-md">@i</span>
                }
                else
                {
                    <a href="@Url.Action("Index", new { page = i })" class="px-4 py-2 rounded-full bg-surface-container-lowest border border-[#EFE6DD] text-on-surface hover:bg-primary/10 transition-colors font-label-md">@i</a>
                }
            }
            @if (Model.HasNextPage)
            {
                <a href="@Url.Action("Index", new { page = Model.PageNumber + 1 })" class="px-3 py-2 rounded-full bg-surface-container-lowest border border-[#EFE6DD] text-on-surface hover:bg-primary/10 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
            }
        </div>
    }
</div>